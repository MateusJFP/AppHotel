<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppHotel.SobrePage"
    Title="Sobre">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Sobre o Aplicativo"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="App Hotel"
            FontSize="22"
            HorizontalOptions="Center" />

        <Label
            Text="Desenvolvedor: Mateus Jorge Fidéles Pereira"
            FontSize="16"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Curso Técnico em Desenvolvimento de Sistemas"
            FontSize="14"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Ano de desenvolvimento: 2026"
            FontSize="14"
            HorizontalOptions="Center" />

        <Button
            Text="Voltar"
            Clicked="OnBackClicked" />

    </VerticalStackLayout>
</ContentPage>
